#!/bin/sh
# Release environment. `mix release` renders this into releases/<vsn>/env.sh, which
# bin/termelix sources before every command (start, remote, rpc, eval, daemon), and before it
# applies its own defaults — so what is exported here wins over them.

# A BEAM crash dump serializes :persistent_term and every ETS table into a plaintext file.
# That is the instance ENCRYPTION_KEY (lib/termelix/crypto/system_crypto.ex:72) together with
# every cached per-user DEK (lib/termelix/crypto/user_key_manager.ex:119) — everything needed
# to decrypt the stored hosts and credentials, written unprompted by the crash handler onto
# the container filesystem. 0 makes the VM skip the dump entirely and just terminate.
ERL_CRASH_DUMP_SECONDS=0
export ERL_CRASH_DUMP_SECONDS

# Distribution stays off unless an operator asks for it. The release default is "sname", which
# starts epmd and opens a distribution port whose only guard is the cookie baked into the image
# at build time (releases/COOKIE) — identical in every container from that image, and readable
# by anyone who can read the image. A distribution peer runs arbitrary code inside the VM, i.e.
# reads the keys above.
#
# Opt in for `bin/termelix remote` / `rpc` with TERMELIX_DISTRIBUTION=sname (short name, local
# host only) or =name (long name; set RELEASE_NODE too). Any other value — including unset and
# a typo — leaves distribution off, so this fails closed.
#
# WHAT THIS COSTS, precisely, so nobody is surprised at 3am:
#   * `bin/termelix start` and `eval` are unaffected (eval boots its own VM).
#   * The CONTAINER lifecycle is unaffected: `docker compose stop/start/restart` signals PID 1
#     and ERTS shuts down cleanly. This is how the instance is actually operated (docs/INFRA.md).
#   * `bin/termelix stop|restart|pid|remote|rpc` DO stop working — they all reach the running
#     node over distribution. Turning it on afterwards does not help: those commands make the
#     *client* VM distributed, while the already-running server was started without it and is
#     not registered with epmd. Enabling it therefore requires a restart, which destroys every
#     `restart: :temporary` terminal session and every tunnel — i.e. exactly the state you
#     wanted a live shell to inspect. Decide before you need it, not after.
#
# A break-glass console (docs/ARCHITECTURE_REVIEW.md P11) must therefore NOT be designed around
# `bin/termelix rpc` unless distribution is turned on by default first.
case "${TERMELIX_DISTRIBUTION:-none}" in
  sname | name) RELEASE_DISTRIBUTION="$TERMELIX_DISTRIBUTION" ;;
  *) RELEASE_DISTRIBUTION=none ;;
esac
export RELEASE_DISTRIBUTION

# When distribution IS enabled, do not use the cookie `mix release` baked into the image: it is
# identical in every container built from that image and readable by anyone who can read the
# image, and a distribution peer runs arbitrary code inside the VM. Generate a per-instance one
# in the data dir (0600, same volume as .env) on first use instead. Only reached when the
# operator opted in above, so the normal path writes nothing.
if [ "$RELEASE_DISTRIBUTION" != "none" ] && [ -z "${RELEASE_COOKIE:-}" ]; then
  _cookie_file="${DATA_DIR:-/app/data}/.erlang_cookie"
  if [ ! -s "$_cookie_file" ]; then
    (umask 077 && od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > "$_cookie_file")
  fi
  RELEASE_COOKIE=$(cat "$_cookie_file")
  export RELEASE_COOKIE
fi
